# Dispatcharr address as seen from the scanner container
DISPATCHARR_URL=http://host.docker.internal:9191
# Dispatcharr → your user menu → Generate API Key
DISPATCHARR_API_KEY=
# Shared secret nginx sends as X-Scanner-Token (any long random string)
SCANNER_TOKEN=

# Channels in this channel profile are scanned
PROFILE_NAME=Plex
# Event channels: skip auto-created ones, plus any groups listed here (comma-separated)
SKIP_AUTO_CREATED=true
EXCLUDE_GROUPS=
# Move/add a working stream to the top when a channel's primary fails
AUTO_FIX=true
SCAN_INTERVAL_HOURS=6
SAMPLE_SECONDS=25
MAX_CANDIDATES=4
BUSY_RETRY_MINUTES=30
