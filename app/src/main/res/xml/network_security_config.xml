<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dispatcharr is commonly self-hosted on a LAN over plain HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
